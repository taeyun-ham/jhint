{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jh-international-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    // 없는 주소는 dist/404.html을 404 상태로(전에는 홈을 200으로 → 구글 Soft 404, 2026-11-25)
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // 대시보드에 넣은 텍스트 변수(INQUIRY_TO_EMAILS 등)를 배포 때 지우지 않음 — 2026-11-23 문의 메일 503 재발 방지
  "keep_vars": true,
}
